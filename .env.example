# -----------------------------------------------------------------------------
# db.local runtime configuration
# -----------------------------------------------------------------------------
# This same file controls local scripts, Docker Compose interpolation, and the
# GitHub Actions deployment wrapper. On the server, GitHub Actions creates and
# preserves a private runtime copy at DEPLOY_ENV_FILE.

# Deployment/server folder locations
ACTIONS_ROOT=${HOME}/actions_db.local
BACKUP_ROOT=${HOME}/backup_db.local
DEPLOY_ENV_FILE=${HOME}/.config/db.local/runtime.env
ROLLBACK_STATE_DIR=${TMPDIR:-/tmp}/db-local-rollback-${USER:-runner}
COMPOSE_WAIT_TIMEOUT=600
DEPLOY_LOG_TAIL=200
SMOKE_READY_TIMEOUT=90
RUN_MINIO_INIT=true
MIN_FREE_DISK_GIB=5
WARN_FREE_DISK_GIB=10
POSTGRES_BACKUP_RETENTION=7
DATA_BACKUP_RETENTION=3
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3
CONTAINER_PIDS_LIMIT=512

# Canonical LAN hostname for the local AWS-compatible platform.
# Host Caddy should proxy https://aws.home.arpa -> 127.0.0.1:8003.
PLATFORM_HOSTNAME=aws.home.arpa

# Logical service switches. All are enabled by default.
ENABLE_POSTGRES=true
ENABLE_REDIS=true
ENABLE_NEO4J=true
ENABLE_MINIO=true
ENABLE_ELASTICMQ=true
ENABLE_COGNITO=true

# Compose project, network, containers, and Docker volume names
COMPOSE_PROJECT_NAME=db-local-stack
DB_NETWORK_NAME=db-local-net

POSTGRES_CONTAINER_NAME=db-postgres
PGADMIN_CONTAINER_NAME=db-pgadmin
REDIS_CONTAINER_NAME=db-redis
REDISINSIGHT_CONTAINER_NAME=db-redisinsight
NEO4J_CONTAINER_NAME=db-neo4j
MINIO_CONTAINER_NAME=db-minio
ELASTICMQ_CONTAINER_NAME=db-elasticmq
ELASTICMQ_UI_CONTAINER_NAME=db-elasticmq-ui
COGNITO_CONTAINER_NAME=db-cognito
DASHBOARD_CONTAINER_NAME=db-dashboard
MINIO_INIT_CONTAINER_NAME=db-minio-init
UI_GATEWAY_CONTAINER_NAME=db-ui-gateway

POSTGRES_VOLUME_NAME=db-postgres-data
PGADMIN_VOLUME_NAME=db-pgadmin-data
REDIS_VOLUME_NAME=db-redis-data
REDISINSIGHT_VOLUME_NAME=db-redisinsight-data
NEO4J_DATA_VOLUME_NAME=db-neo4j-data
NEO4J_LOGS_VOLUME_NAME=db-neo4j-logs
NEO4J_IMPORT_VOLUME_NAME=db-neo4j-import
NEO4J_PLUGINS_VOLUME_NAME=db-neo4j-plugins
MINIO_VOLUME_NAME=db-minio-data
ELASTICMQ_VOLUME_NAME=db-elasticmq-data
COGNITO_VOLUME_NAME=db-cognito-data
UI_GATEWAY_DATA_VOLUME_NAME=db-ui-gateway-data
UI_GATEWAY_CONFIG_VOLUME_NAME=db-ui-gateway-config

# Repo-relative folders/files used by Compose and scripts
POSTGRES_INITDB_DIR=./initdb/postgres
ELASTICMQ_CONFIG_FILE=./config/elasticmq.conf
DASHBOARD_WWW_DIR=./www
GENERATED_DIR=./generated
PGADMIN_GENERATED_DIR=./generated/pgadmin
PGADMIN_SERVERS_JSON=./generated/pgadmin/servers.json
COGNITO_GENERATED_DIR=./generated/cognito
COGNITO_CONFIG_FILE=./generated/cognito/config.json
DASHBOARD_GENERATED_DIR=./generated/dashboard
DASHBOARD_RUNTIME_CONFIG=./generated/dashboard/runtime-config.js
LOCAL_BACKUP_DIR=./backups
POSTGRES_BACKUP_DIR=./backups/postgres

# -----------------------------------------------------------------------------
# Network binding and ports
# -----------------------------------------------------------------------------
# Raw service APIs bind to the LAN and should be protected by host firewall.
DB_HOST_BIND=0.0.0.0
# Browser/admin backends stay on the private Compose network. The dedicated UI
# gateway publishes HTTPS on the documented UI ports.
ADMIN_UI_HOST_BIND=127.0.0.1
UI_GATEWAY_HOST_BIND=0.0.0.0

# Static dashboard page. Keep this on localhost because host Caddy proxies it.
DASHBOARD_HOST_BIND=127.0.0.1
DASHBOARD_PORT=8003

# PostgreSQL + pgvector
POSTGRES_PORT=5432
POSTGRES_DB=langgraph_app
POSTGRES_USER=langgraph_user
POSTGRES_PASSWORD=change_me_postgres_2026

# pgAdmin
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@local.dev
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin_2026

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_2026
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# RedisInsight
REDISINSIGHT_PORT=5540

# Neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_me_neo4j_2026
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512m
NEO4J_HEALTHCHECK_INTERVAL=15s
NEO4J_HEALTHCHECK_TIMEOUT=10s
NEO4J_HEALTHCHECK_RETRIES=40
NEO4J_HEALTHCHECK_START_PERIOD=120s

# MinIO
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_2026
MINIO_DEFAULT_BUCKET=langgraph-app

# ElasticMQ + official ElasticMQ UI
ELASTICMQ_PORT=9324
ELASTICMQ_UI_PORT=9325

# Cognito Local (Amazon Cognito User Pools emulator)
COGNITO_IMAGE=jagregory/cognito-local:5.3.0
COGNITO_PORT=9229

# Conservative resource guardrails for a 16 GiB local-development server.
POSTGRES_MEMORY_LIMIT=2g
POSTGRES_CPU_LIMIT=2.0
PGADMIN_MEMORY_LIMIT=768m
PGADMIN_CPU_LIMIT=1.0
REDIS_MEMORY_LIMIT=1g
REDIS_CPU_LIMIT=1.0
REDISINSIGHT_MEMORY_LIMIT=768m
REDISINSIGHT_CPU_LIMIT=1.0
NEO4J_MEMORY_LIMIT=2560m
NEO4J_CPU_LIMIT=2.0
MINIO_MEMORY_LIMIT=1536m
MINIO_CPU_LIMIT=1.5
ELASTICMQ_MEMORY_LIMIT=768m
ELASTICMQ_CPU_LIMIT=1.0
ELASTICMQ_UI_MEMORY_LIMIT=512m
ELASTICMQ_UI_CPU_LIMIT=0.5
COGNITO_MEMORY_LIMIT=512m
COGNITO_CPU_LIMIT=0.5
DASHBOARD_MEMORY_LIMIT=64m
DASHBOARD_CPU_LIMIT=0.25
MINIO_INIT_MEMORY_LIMIT=256m
MINIO_INIT_CPU_LIMIT=0.5
UI_GATEWAY_MEMORY_LIMIT=128m
UI_GATEWAY_CPU_LIMIT=0.5
