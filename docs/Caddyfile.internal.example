# System-level Caddy route for the dashboard. The Compose ui-gateway serves the
# browser/admin consoles on their own HTTPS ports under the same hostname.
#
# Dashboard:    https://aws.home.arpa
# pgAdmin:      https://aws.home.arpa:5050
# RedisInsight: https://aws.home.arpa:5540
# Neo4j:        https://aws.home.arpa:7474
# MinIO:        https://aws.home.arpa:9001
# ElasticMQ UI: https://aws.home.arpa:9325
# Cognito UI/API: https://aws.home.arpa:9229
#
# Raw APIs remain direct LAN services: PostgreSQL 5432, Redis 6379, Neo4j Bolt
# 7687, MinIO 9000, and ElasticMQ 9324. Cognito Local is HTTPS-proxied on 9229.

aws.home.arpa {
    tls internal
    reverse_proxy 127.0.0.1:8003
}
