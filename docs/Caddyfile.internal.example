# Merge these site blocks into the host /etc/caddy/Caddyfile.
# tls internal uses Caddy's private CA. Clients that do not trust that CA will
# show a certificate warning, which is intentional for this LAN-only setup.

dbs.home.arpa {
    tls internal
    reverse_proxy 127.0.0.1:8003
}

pgadmin.dbs.home.arpa {
    tls internal
    reverse_proxy 127.0.0.1:5050
}

redis.dbs.home.arpa {
    tls internal
    reverse_proxy 127.0.0.1:5540
}

neo4j.dbs.home.arpa {
    tls internal
    reverse_proxy 127.0.0.1:7474
}

minio.dbs.home.arpa {
    tls internal
    reverse_proxy 127.0.0.1:9001
}

sqs.dbs.home.arpa {
    tls internal
    reverse_proxy 127.0.0.1:9325
}
