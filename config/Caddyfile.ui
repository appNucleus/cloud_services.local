{
    auto_https disable_redirects
}

https://{$PLATFORM_HOSTNAME}:5050 {
    tls internal
    reverse_proxy pgadmin:8080
}

https://{$PLATFORM_HOSTNAME}:5540 {
    tls internal
    reverse_proxy redisinsight:5540
}

https://{$PLATFORM_HOSTNAME}:7474 {
    tls internal
    reverse_proxy neo4j:7474
}

https://{$PLATFORM_HOSTNAME}:9001 {
    tls internal
    reverse_proxy minio:9001
}

https://{$PLATFORM_HOSTNAME}:9325 {
    tls internal
    reverse_proxy elasticmq-ui:3000
}
